# Anthropic API key for the Claude classifier + extractor
ANTHROPIC_API_KEY=sk-ant-api03-...

# Session-cookie signing secret (HMAC-SHA256 key).
# Generate a fresh random string for any new deployment:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-random-32-char-string

# Optional overrides for the built-in admin account.
# Defaults to: admin / noventiq
# Set these when deploying to a public URL.
# APP_USER=admin
# APP_PASSWORD=noventiq

# Postgres connection string for the user + projects DB. Set this in
# .env.local for local dev (.env.local is gitignored) and as a Vercel
# project env var for production. Without it the app falls back to the
# bootstrap admin only — registration and saved projects are disabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
