# Anthropic API key for the Claude classifier + extractor
ANTHROPIC_API_KEY=sk-ant-api03-...

# Session-cookie signing secret (HMAC-SHA256 key). Also signs the
# per-browser account-record cookie that backs the /register flow.
# Generate a fresh random string for any new deployment:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=KQZMIV6kyjbjkxExrmmJyhYAFMqz4Fo3

# Bootstrap admin credential. Lets you sign in WITHOUT registering and
# regardless of which browser you're on. Falls back to BETTER_AUTH_SECRET
# when APP_PASSWORD is unset.
APP_USER=admin
APP_PASSWORD=
