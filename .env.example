# Anthropic API key for the Claude classifier + extractor
ANTHROPIC_API_KEY=sk-ant-api03-...

# Session cookie signing secret (used as HMAC-SHA256 key).
# Generate a fresh random string for any new deployment:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=KQZMIV6kyjbjkxExrmmJyhYAFMqz4Fo3

# Bootstrap admin credential. Lets you sign in BEFORE any users have
# registered. Falls back to BETTER_AUTH_SECRET if APP_PASSWORD is unset.
APP_USER=admin
APP_PASSWORD=

# Vercel KV (Upstash Redis) for the multi-user account store. Without
# these, registration is disabled in production (and uses an in-memory
# Map in dev). Enable "Storage → Marketplace → Upstash for Redis" in
# the Vercel dashboard and connect it to the project — KV_REST_API_URL
# and KV_REST_API_TOKEN are then auto-populated.
KV_REST_API_URL=
KV_REST_API_TOKEN=
