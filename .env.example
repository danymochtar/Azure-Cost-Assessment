# Anthropic API key for the Claude classifier + extractor
ANTHROPIC_API_KEY=sk-ant-api03-...

# Session cookie signing secret (used as HMAC-SHA256 key).
# Generate a fresh random string for any new deployment:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=KQZMIV6kyjbjkxExrmmJyhYAFMqz4Fo3

# Single-user gate. The login form asks for this password.
# Defaults to BETTER_AUTH_SECRET if APP_PASSWORD is unset — set a
# distinct value when you deploy publicly.
APP_USER=admin
APP_PASSWORD=
